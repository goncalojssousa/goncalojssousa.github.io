    <style>
        /* =========================================================
           RESET & GLOBAL
        ========================================================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --navy: #08111f;
            --navy-light: #101d30;
            --blue: #18324f;
            --gold: #c8a96b;
            --gold-light: #e2c98f;
            --white: #f8f8f6;
            --off-white: #f3f1eb;
            --gray: #9ca6b3;
            --dark-gray: #5c6673;
            --black: #050a11;
            --border: rgba(255,255,255,0.10);
            --max-width: 1200px;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Georgia, "Times New Roman", serif;
            background: var(--navy);
            color: var(--white);
            line-height: 1.6;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        .container {
            width: min(90%, var(--max-width));
            margin: auto;
        }

        .sans {
            font-family: Arial, Helvetica, sans-serif;
        }


        /* =========================================================
           NAVIGATION
        ========================================================= */

        nav {
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 1000;

            background: rgba(8, 17, 31, 0.88);
            backdrop-filter: blur(14px);

            border-bottom: 1px solid var(--border);
        }

        .nav-inner {
            height: 76px;

            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .logo {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 15px;
            font-weight: 700;
            letter-spacing: 2px;
        }

        .logo span {
            color: var(--gold);
        }

        .nav-links {
            display: flex;
            gap: 30px;

            font-family: Arial, Helvetica, sans-serif;
            font-size: 12px;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .nav-links a {
            color: #cbd2dc;
            transition: color 0.25s ease;
        }

        .nav-links a:hover {
            color: var(--gold);
        }


        /* =========================================================
           HERO
        ========================================================= */

        .hero {
            min-height: 100vh;

            display: flex;
            align-items: center;

            position: relative;
            overflow: hidden;

            background:
                radial-gradient(
                    circle at 80% 20%,
                    rgba(200,169,107,0.10),
                    transparent 35%
                ),
                linear-gradient(
                    135deg,
                    #08111f 0%,
                    #0b1728 55%,
                    #07101c 100%
                );
        }

        .hero::before {
            content: "";
            position: absolute;
            inset: 0;

            background-image:
                linear-gradient(
                    rgba(255,255,255,0.025) 1px,
                    transparent 1px
                ),
                linear-gradient(
                    90deg,
                    rgba(255,255,255,0.025) 1px,
                    transparent 1px
                );

            background-size: 80px 80px;

            mask-image: linear-gradient(
                to bottom,
                black,
                transparent
            );
        }

        .hero-content {
            position: relative;
            z-index: 2;

            padding-top: 76px;
        }

        .eyebrow {
            font-family: Arial, Helvetica, sans-serif;
            text-transform: uppercase;
            letter-spacing: 3px;
            font-size: 11px;
            color: var(--gold);
            margin-bottom: 25px;
        }

        .hero h1 {
            font-size: clamp(52px, 8vw, 100px);
            font-weight: 400;
            line-height: 0.95;

            max-width: 900px;
            margin-bottom: 35px;
        }

        .hero h1 span {
            color: var(--gold);
        }

        .hero-description {
            max-width: 650px;

            font-family: Arial, Helvetica, sans-serif;
            color: #b8c0cb;
            font-size: 17px;
            line-height: 1.8;

            margin-bottom: 45px;
        }

        .hero-actions {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }

        .btn {
            display: inline-block;

            padding: 14px 25px;

            font-family: Arial, Helvetica, sans-serif;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;

            border: 1px solid var(--gold);

            transition: all 0.25s ease;
        }

        .btn-primary {
            background: var(--gold);
            color: var(--navy);
        }

        .btn-primary:hover {
            background: var(--gold-light);
            border-color: var(--gold-light);
        }

        .btn-outline {
            color: var(--gold);
        }

        .btn-outline:hover {
            background: rgba(200,169,107,0.10);
        }

        .scroll-indicator {
            position: absolute;
            bottom: 30px;
            left: 50%;

            transform: translateX(-50%);

            font-family: Arial, Helvetica, sans-serif;
            font-size: 9px;
            letter-spacing: 3px;
            text-transform: uppercase;

            color: var(--gray);
        }


        /* =========================================================
           SECTION BASICS
        ========================================================= */

        section {
            padding: 110px 0;
        }

        .section-light {
            background: var(--off-white);
            color: var(--navy);
        }

        .section-dark {
            background: var(--navy);
        }

        .section-header {
            margin-bottom: 65px;
        }

        .section-number {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 11px;
            letter-spacing: 2px;
            color: var(--gold);

            margin-bottom: 12px;
        }

        .section-title {
            font-size: clamp(38px, 5vw, 58px);
            font-weight: 400;
            line-height: 1.05;
        }

        .section-subtitle {
            max-width: 600px;
            margin-top: 20px;

            font-family: Arial, Helvetica, sans-serif;
            color: var(--gray);
        }

        .section-light .section-subtitle {
            color: var(--dark-gray);
        }


        /* =========================================================
           ABOUT
        ========================================================= */

        .about-grid {
            display: grid;
            grid-template-columns: 1fr 1.5fr;
            gap: 80px;
            align-items: start;
        }

        .about-label {
            font-family: Arial, Helvetica, sans-serif;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-size: 10px;
            color: var(--gold);
        }

        .about-text {
            font-size: 23px;
            line-height: 1.65;
        }

        .about-text strong {
            color: var(--gold);
            font-weight: 400;
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;

            margin-top: 45px;
        }

        .stat {
            border-top: 1px solid rgba(8,17,31,0.2);
            padding-top: 20px;
        }

        .stat-number {
            font-size: 38px;
            color: var(--navy);
        }

        .stat-label {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--dark-gray);
        }


        /* =========================================================
           EXPERIENCE
        ========================================================= */

        .timeline {
            border-left: 1px solid var(--border);
        }

        .timeline-item {
            position: relative;

            display: grid;
            grid-template-columns: 200px 1fr;
            gap: 50px;

            padding: 0 0 60px 45px;
        }

        .timeline-item::before {
            content: "";

            position: absolute;
            left: -5px;
            top: 5px;

            width: 9px;
            height: 9px;

            background: var(--gold);
            border-radius: 50%;
        }

        .timeline-date {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 11px;
            color: var(--gold);
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .timeline-role {
            font-size: 28px;
            margin-bottom: 5px;
        }

        .timeline-company {
            font-family: Arial, Helvetica, sans-serif;
            color: #c2cad4;
            font-size: 13px;
            margin-bottom: 20px;
        }

        .timeline-description {
            font-family: Arial, Helvetica, sans-serif;
            color: var(--gray);
            font-size: 14px;
            line-height: 1.8;
            max-width: 700px;
        }


        /* =========================================================
           PROJECTS
        ========================================================= */

        .projects-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 2px;

            background: rgba(255,255,255,0.08);
        }

        .project {
            min-height: 330px;

            padding: 40px;

            background: var(--navy-light);

            display: flex;
            flex-direction: column;
            justify-content: space-between;

            transition: background 0.3s ease;
        }

        .project:hover {
            background: #15253a;
        }

        .project-number {
            font-family: Arial, Helvetica, sans-serif;
            color: var(--gold);
            font-size: 11px;
        }

        .project h3 {
            font-size: 29px;
            font-weight: 400;
            margin: 20px 0;
        }

        .project p {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 13px;
            color: var(--gray);
            line-height: 1.7;
        }

        .project-link {
            margin-top: 25px;

            font-family: Arial, Helvetica, sans-serif;
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 1.5px;

            color: var(--gold);
        }


        /* =========================================================
           SKILLS
        ========================================================= */

        .skills-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
        }

        .skill-group {
            padding: 35px;

            border: 1px solid rgba(8,17,31,0.15);
        }

        .skill-group h3 {
            font-size: 22px;
            font-weight: 400;
            margin-bottom: 25px;
        }

        .skill-list {
            list-style: none;

            font-family: Arial, Helvetica, sans-serif;
            color: var(--dark-gray);
            font-size: 13px;
        }

        .skill-list li {
            padding: 9px 0;
            border-bottom: 1px solid rgba(8,17,31,0.08);
        }


        /* =========================================================
           EDUCATION
        ========================================================= */

        .education-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2px;

            background: rgba(255,255,255,0.08);
        }

        .education-card {
            padding: 45px;
            background: var(--navy-light);
        }

        .education-year {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 10px;
            letter-spacing: 2px;
            color: var(--gold);
        }

        .education-card h3 {
            font-size: 28px;
            font-weight: 400;
            margin: 15px 0 8px;
        }

        .education-card p {
            font-family: Arial, Helvetica, sans-serif;
            color: var(--gray);
            font-size: 13px;
        }


        /* =========================================================
           CONTACT
        ========================================================= */

        .contact {
            text-align: center;

            background:
                radial-gradient(
                    circle at center,
                    #17263a,
                    var(--navy) 65%
                );
        }

        .contact h2 {
            font-size: clamp(45px, 7vw, 80px);
            font-weight: 400;

            margin-bottom: 25px;
        }

        .contact p {
            font-family: Arial, Helvetica, sans-serif;
            color: var(--gray);
            max-width: 550px;
            margin: 0 auto 40px;
        }

        .contact-links {
            display: flex;
            justify-content: center;
            gap: 30px;
            flex-wrap: wrap;

            font-family: Arial, Helvetica, sans-serif;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
        }

        .contact-links a {
            color: var(--gold);
        }


        /* =========================================================
           FOOTER
        ========================================================= */

        footer {
            padding: 30px 0;

            border-top: 1px solid var(--border);

            font-family: Arial, Helvetica, sans-serif;
            font-size: 10px;
            letter-spacing: 1px;
            color: var(--gray);
        }

        .footer-inner {
            display: flex;
            justify-content: space-between;
            gap: 20px;
        }


        /* =========================================================
           MOBILE
        ========================================================= */

        @media (max-width: 800px) {

            .nav-links {
                display: none;
            }

            section {
                padding: 80px 0;
            }

            .about-grid {
                grid-template-columns: 1fr;
                gap: 40px;
            }

            .about-text {
                font-size: 20px;
            }

            .stats {
                grid-template-columns: 1fr;
            }

            .timeline-item {
                grid-template-columns: 1fr;
                gap: 12px;
                padding-left: 30px;
            }

            .projects-grid {
                grid-template-columns: 1fr;
            }

            .skills-grid {
                grid-template-columns: 1fr;
            }

            .education-grid {
                grid-template-columns: 1fr;
            }

            .hero h1 {
                font-size: 55px;
            }

            .footer-inner {
                flex-direction: column;
            }
        }
    </style>
</head>


